# MCP server config can carry API keys in plaintext headers.
# `claude mcp add -s project` writes this file into the repo root.
.mcp.json

# Credentials
.env
.env.*
*.pem
*.key
secrets.json

# Local Claude Code state
.claude/settings.local.json

# OS noise
.DS_Store
Thumbs.db

# Python bytecode, generated when a skill's scripts run
__pycache__/
*.py[cod]

# Tool logs, written into whatever directory the CLI is run from
vibe-session.log
